// Prisma schema for the truck / trip / bella (brick) management dashboard.
//
// Conventions
// - Money is Decimal(14,2) (INR). Per-brick prices are Decimal(12,2).
// - Every business table carries user_id and a composite unique (id, user_id).
//   Child rows reference parents through (parent_id, user_id) so the database
//   itself refuses links across users.
// - Derived values (revenue, totals, amount received/remaining, mileage) are
//   NOT stored. They come from src/server/services/calc.ts and the SQL view
//   "trip_financials" (see migrations), which implement the same rules.
// - CHECK constraints and the view live in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth core tables (+ username plugin + phone additional field)
// ---------------------------------------------------------------------------

model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false) @map("email_verified")
  image           String?
  username        String?   @unique
  displayUsername String?   @map("display_username")
  phone           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions        Session[]
  accounts        Account[]

  trucks    Truck[]
  drivers   Driver[]
  customers Customer[]
  bellas    Bella[]
  tripCosts TripCost[]
  trips     Trip[]
  payments  Payment[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Business tables
// ---------------------------------------------------------------------------

model Truck {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  /// Normalised: trimmed, upper-cased, inner whitespace collapsed.
  registrationNumber String   @map("registration_number")
  /// Manually entered total diesel spend (INR).
  dieselCost         Decimal  @map("diesel_cost") @db.Decimal(14, 2)
  /// Manually entered total diesel consumed (litres).
  dieselLiters       Decimal  @map("diesel_liters") @db.Decimal(12, 2)
  /// Manually entered total distance (km).
  distanceTraveled   Decimal  @map("distance_traveled") @db.Decimal(12, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips Trip[]

  @@unique([id, userId])
  @@unique([userId, registrationNumber])
  @@index([userId, createdAt])
  @@map("truck")
}

model Driver {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  phone     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips Trip[]

  @@unique([id, userId])
  @@index([userId, createdAt])
  @@map("driver")
}

model Customer {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  phone     String?
  location  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips Trip[]

  @@unique([id, userId])
  @@index([userId, createdAt])
  @@map("customer")
}

/// Bella = bricks. One record per trip, created/edited/deleted via the trip.
/// Only `source` and `sourceOwnership` may be edited directly (they never
/// affect money). Quantity and prices change only through the trip form,
/// which keeps the trip's locked copy identical.
model Bella {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  source          String
  quantity        Int
  /// Per-brick cost price (INR).
  costPrice       Decimal  @map("cost_price") @db.Decimal(12, 2)
  /// Per-brick selling price (INR).
  sellingPrice    Decimal  @map("selling_price") @db.Decimal(12, 2)
  /// true = own kiln. Informational flag.
  sourceOwnership Boolean  @map("source_ownership")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip?

  @@unique([id, userId])
  @@index([userId, createdAt])
  @@map("bella")
}

/// Per-trip expense breakdown. The total is never stored.
model TripCost {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  diesel        Decimal  @default(0) @db.Decimal(14, 2)
  adblue        Decimal  @default(0) @db.Decimal(14, 2)
  royalty       Decimal  @default(0) @db.Decimal(14, 2)
  tollTaxes     Decimal  @default(0) @map("toll_taxes") @db.Decimal(14, 2)
  driverSalary  Decimal  @default(0) @map("driver_salary") @db.Decimal(14, 2)
  miscellaneous Decimal  @default(0) @db.Decimal(14, 2)
  labour        Decimal  @default(0) @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip?

  @@unique([id, userId])
  @@map("trip_cost")
}

model Trip {
  id         String @id @default(cuid())
  userId     String @map("user_id")
  customerId String @map("customer_id")
  bellaId    String @map("bella_id")
  tripCostId String @map("trip_cost_id")
  truckId    String @map("truck_id")
  driverId   String @map("driver_id")

  /// Business date of the trip (calendar date, Asia/Kolkata).
  tripDate   DateTime @map("trip_date") @db.Date
  distance   Decimal  @db.Decimal(12, 2)
  startPoint String   @map("start_point")
  endPoint   String   @map("end_point")

  // Locked copy of brick figures used for all money on this trip.
  brickQuantity        Int     @map("brick_quantity")
  brickCostPrice       Decimal @map("brick_cost_price") @db.Decimal(12, 2)
  brickSellingPrice    Decimal @map("brick_selling_price") @db.Decimal(12, 2)
  brickSourceOwnership Boolean @map("brick_source_ownership")

  /// May be false only when brickSourceOwnership is true (DB CHECK).
  includeBrickCost    Boolean  @default(true) @map("include_brick_cost")
  /// System-maintained: revenue - brick cost (if included) - total trip cost.
  netMarginCalculated Decimal  @map("net_margin_calculated") @db.Decimal(14, 2)
  /// User-maintained manual override. Never touched by recalculation.
  netMarginOverride   Decimal? @map("net_margin_override") @db.Decimal(14, 2)

  /// System-maintained: true while amount remaining > 0.
  paymentDue Boolean @map("payment_due")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId, userId], references: [id, userId], onDelete: NoAction)
  bella    Bella    @relation(fields: [bellaId, userId], references: [id, userId], onDelete: NoAction)
  tripCost TripCost @relation(fields: [tripCostId, userId], references: [id, userId], onDelete: NoAction)
  truck    Truck    @relation(fields: [truckId, userId], references: [id, userId], onDelete: NoAction)
  driver   Driver   @relation(fields: [driverId, userId], references: [id, userId], onDelete: NoAction)
  payments Payment[]

  @@unique([id, userId])
  /// 1:1 with bella / trip_cost (their ids are globally unique, so this is
  /// effectively unique on the id alone).
  @@unique([bellaId, userId])
  @@unique([tripCostId, userId])
  @@index([userId, tripDate])
  @@index([userId, paymentDue])
  @@index([userId, customerId])
  @@index([userId, truckId])
  @@index([userId, driverId])
  @@map("trip")
}

model Payment {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tripId    String   @map("trip_id")
  amount    Decimal  @db.Decimal(14, 2)
  /// Calendar date the payment was received (Asia/Kolkata).
  paidOn    DateTime @map("paid_on") @db.Date
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [tripId, userId], references: [id, userId], onDelete: Cascade)

  @@index([tripId])
  @@index([userId, paidOn])
  @@map("payment")
}
