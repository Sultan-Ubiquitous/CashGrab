# Neon: pooled connection (hostname contains "-pooler") used by the Worker at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon: direct (unpooled) connection used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Reserved for future database-backed integration tests (not used by `pnpm test`
# today, which only runs pure unit tests and never touches a database).
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-test-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth. Authorised redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
